<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roamly_blush"
    tools:context=".activity.OnboardingActivity">

    <!-- Logo al centro in alto -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="58dp"
        app:srcCompat="@drawable/logo_no_background" />

    <!-- Nome dell'app, sotto il logo -->
    <TextView
        android:id="@+id/Roamly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/logo"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/protest_guerrilla"
        android:text="ROAMLY"
        android:textSize="30sp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Motto dell'app ("Belong Anywhere") -->
    <TextView
        android:id="@+id/Punchline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/Roamly"
        android:fontFamily="@font/protest_guerrilla"
        android:text="@string/belong_anywhere"
        android:textStyle="italic"
        android:textSize="24sp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenitore verticale per i bottoni Login e Signup -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="40dp"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintTop_toBottomOf="@id/Punchline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Bottone Login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/roamly_red"
            android:text="@string/login"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:fontFamily="@font/roboto_variablefont" />

        <!-- Bottone Signup -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/roamly_red"
            android:text="@string/signup"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:fontFamily="@font/roboto_variablefont" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleOnboarding"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/roboto_variablefont"
            android:text="@string/auth_google_button"
            android:textColor="@color/roamly_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="22dp"
            app:iconTint="@null"
            app:strokeColor="@color/light_gray"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
